# Application Settings
APP_NAME=DocDrift API
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_V1_STR=/api/v1

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=docdrift_db
# Async Database URL: postgresql+asyncpg://user:pass@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docdrift_db

# ChromaDB Settings
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SSL=false
CHROMA_PERSIST_DIRECTORY=./chroma_db_data
CHROMA_COLLECTION_NAME=docdrift_chunks

# AI & Embedding Providers
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/text-embedding-004
